<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.insurancehub</groupId>
  <artifactId>insurance-hub-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Insurance Hub</name>
  <description>Parent POM for the Insurance Hub microservices (hub-gateway, policy-service, claims-service, hub-common)</description>

  <modules>
    <module>hub-common</module>
    <module>hub-gateway</module>
    <module>policy-service</module>
    <module>claims-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Library versions not managed by the Spring Boot BOM. Bump deliberately, not automatically. -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <nimbus-jose-jwt.version>10.0.2</nimbus-jose-jwt.version>
    <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
    <archunit.version>1.4.1</archunit.version>
    <wiremock.version>3.10.0</wiremock.version>
    <!-- resilience4j-spring-boot4: confirmed working under Boot 4.1.1 by the phase-3 dependency
         spike (docs/adr/0001-tech-stack.md) - @CircuitBreaker/@Retry proxying and fallback
         dispatch both work with no extra AOP dependency. -->
    <resilience4j.version>2.4.0</resilience4j.version>

    <spotless.version>3.0.0</spotless.version>
    <jacoco.version>0.8.13</jacoco.version>
    <!-- Domain + application packages are the coverage-gated code; see docs/adr/0001-tech-stack.md -->
    <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
  </properties>

  <dependencyManagement>
    <!-- Testcontainers is already imported (as testcontainers-bom, at ${testcontainers.version})
         by spring-boot-dependencies; no need to re-import it here. -->
    <dependencies>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc-openapi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-spring-boot4</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>

        <plugin>
          <!-- -Xlint:deprecation -Werror: a deprecated API (e.g. HttpStatus.PAYLOAD_TOO_LARGE,
               already hit once in hub-gateway's own error mapping - see docs/progress.md phase 5
               notes) fails the build at compile time instead of surfacing later as a silently
               wrong runtime value. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:deprecation</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <!-- Unit/slice/ArchUnit tests only: *Test.java, *Tests.java (Surefire's own
               defaults). *IT.java is explicitly excluded too - belt and suspenders, since it
               already doesn't match Surefire's default include patterns, but relying on that
               silently is exactly how an *IT class went unrun for a while during phase 2. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
          </configuration>
        </plugin>

        <plugin>
          <!-- Integration tests (Testcontainers etc.): *IT.java. Failsafe auto-binds its
               integration-test + verify goals to those same lifecycle phases just by being
               declared active (no explicit <executions> needed - same convention Surefire
               already relies on for its own default `test`-phase binding), so `mvn test`
               never runs them but `mvn verify` always does. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat/>
              <removeUnusedImports/>
              <importOrder/>
              <endWithNewline/>
              <trimTrailingWhitespace/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${jacoco.line.coverage.minimum}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
                <includes>
                  <include>**/domain/**</include>
                  <include>**/application/**</include>
                </includes>
                <!-- Enforced: a real coverage shortfall in domain/application fails the build. -->
                <haltOnFailure>true</haltOnFailure>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
