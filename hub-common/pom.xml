<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.insurancehub</groupId>
    <artifactId>insurance-hub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>hub-common</artifactId>
  <packaging>jar</packaging>

  <name>hub-common</name>
  <description>Shared, deliberately tiny library: HubResponse, HubErrorCode, header constants, PII masking, correlation filter. No entities, no domain logic. See CLAUDE.md rule 2.</description>

  <dependencies>
    <!-- Slim on purpose: SLF4J API for logging/MDC, servlet API (provided) for the correlation
         filter, Jakarta Validation API for shared constraint annotations. No spring-boot-starter-web,
         no persistence, no messaging. Every consuming service already brings those itself. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <!-- ClientHttpRequestInterceptor, and HttpStatus/HttpStatusCode for HubErrorCode. -->
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <!-- @AutoConfiguration, @ConditionalOnClass, @ConditionalOnWebApplication. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <!-- FilterRegistrationBean; declared directly rather than relying on it arriving
           transitively via spring-boot-autoconfigure, since we import its classes directly. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Actually serialize HubResponse to assert its JSON shape; jackson-annotations alone
           can't serialize. -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- ApplicationContextRunner, to test HubCommonAutoConfiguration's conditional wiring. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Library module: no spring-boot-maven-plugin (would try to build an executable jar).
       Surefire/Failsafe are already active for every module via the root pom. -->
</project>
